Instance: example-Practitioner-family-doctor
InstanceOf: Practitioner
Title: "Practitioner example - family doctor"
Description: "Simple Family Doctor Practitioner to serve as a referring physician"
Usage: #example

* identifier.type.coding = HL7V2#EI "Employee Number"
* identifier.system = "http://www.santamonicapartners.org/identifiers/physicians"
* identifier.value = "1234567"
* name.family = "Welby"
* name.given = "Marcus"
* name.suffix = "MD"